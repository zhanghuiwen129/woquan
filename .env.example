# ============================================================
# Hublog 配置参考模板（仅文档用途）
#
# ⚠️ 重要：本项目的【真实配置】是安装程序生成的 config.php（基于 config.example.php 的 define()），
#          .env / EnvLoader 在本版本【未接入】，改这里不会生效。需要改配置请编辑 config.php，
#          或在后台「系统设置」中调整。本文件仅作为「有哪些可配置项」的参考清单。
#
# 下面的键名部分与 config.php 的 define 同名，仅供对照；实际取值以 config.php 为准。
#
# 用法（仅当你自行接入 EnvLoader 时）：
#   1. 复制此文件为 .env（推荐放到项目的上一级目录，最安全）
#   2. 根据实际环境修改下面的值
#   3. 保存后 .env 文件权限建议设为 600（仅拥有者可读写）
#
# ⚠️ 注意：
#   - .env 文件包含数据库密码等敏感信息，严禁提交到 Git / 公开仓库
#   - 值如果包含空格、#、特殊字符，请用双引号包裹
# ============================================================

# ──────────────────────────────────────
# 1. 数据库配置（必须修改）
# ──────────────────────────────────────
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="your_database_name"
DB_USER="your_database_user"
DB_PASS="your_database_password"
DB_CHARSET="utf8mb4"

# ──────────────────────────────────────
# 2. 应用基础配置
# ──────────────────────────────────────
APP_NAME="Hublog"
APP_VERSION="v2.0"
# 开发环境：true（显示错误），生产环境：false
APP_DEBUG=false
# 站点 URL（不带末尾 /），用于邮件、分享链接等；留空自动识别
APP_URL=""
# 时区：国内建议 Asia/Shanghai
TIMEZONE="Asia/Shanghai"

# ──────────────────────────────────────
# 3. 安全 & 认证（必须修改，特别是 JWT_SECRET）
# ──────────────────────────────────────
# JWT 签名密钥：建议 64 位随机字符串。修改后所有已登录用户会被强制下线
JWT_SECRET="please-change-this-to-a-64-char-random-hex-string-change-me"
# JWT 过期时间（秒）：默认 7 天 = 604800
JWT_EXPIRE=604800
# CSRF Token TTL（秒）
CSRF_TOKEN_EXPIRE=3600
# password_hash cost：数值越大越慢越安全；4C8G 服务器建议 12
PASSWORD_COST=12
# 受信任的反向代理 IP（多个用逗号分隔）
TRUSTED_PROXIES="127.0.0.1,::1"

# ──────────────────────────────────────
# 4. 请求限流
# ──────────────────────────────────────
# 全局请求数限制：每 60 秒
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW=60

# ──────────────────────────────────────
# 5. 上传配置
# ──────────────────────────────────────
# 单文件最大 10MB（10 * 1024 * 1024 字节）
UPLOAD_MAX_SIZE=10485760
# 允许的图片 MIME 类型
UPLOAD_IMAGE_TYPES="image/jpeg,image/png,image/gif,image/webp"
# 附件允许的扩展名（小写，逗号分隔）
UPLOAD_ATTACHMENT_EXTS="zip,rar,7z,pdf,doc,docx,xls,xlsx,ppt,pptx,txt"

# ──────────────────────────────────────
# 6. 缓存配置
# ──────────────────────────────────────
# file（默认，无需扩展）或 redis（生产推荐，需安装 redis 扩展）
CACHE_DRIVER="file"
CACHE_PREFIX="hublog_"
# 默认缓存 TTL（秒），1 小时
CACHE_TTL=3600

# ──────────────────────────────────────
# 7. 模板 / 前端
# ──────────────────────────────────────
DEFAULT_TEMPLATE="moments"

# ──────────────────────────────────────
# 8. 跨域（CORS）
# ──────────────────────────────────────
# 允许的跨域域名（多个用逗号分隔，不要末尾 /）；默认同源即可，App/H5 一般无需配置
CORS_ALLOWED_ORIGINS="https://example.com,https://www.example.com"

# ──────────────────────────────────────
# 9. 日志 / 告警
# ──────────────────────────────────────
# 说明：日志保留天数、告警邮箱、管理员 IP 白名单等项在此版本未接入 .env，
#       请在 config.php（对应的 define 常量）或后台「系统设置」中调整。

# ──────────────────────────────────────
# 10. 定时任务（cron）鉴权
# ──────────────────────────────────────
# 三个外部 cron 入口共用同一个 token：
#   POST /api/cron/jobs        （异步任务队列 worker）
#   POST /api/cron/scheduled   （定时发布调度）
#   POST /api/cron/badges      （徽章定时扫描）
# 调用方式二选一：请求体 {"secret": "<token>"} 或请求头 X-Cron-Token: <token>。
#
# ⚠ 取值优先级（唯一真源见 api/core/CronAuth.php）：
#   ① config.php 里的 define('CRON_SECRET', '...') —— 定义且非空时生效
#   ② 数据库 settings 表的 cron_secret 行（后台「系统设置」里填的那一栏）
#   ③ 都没有 → 视为「未配置」
#
#   也就是说：只要 config.php 里定义了 CRON_SECRET，后台改数据库那栏不会再生效。
#   这是故意的 —— 让部署期的文件配置压过运行期可被误改的数据库配置。
#
# ⚠ 未配置时三个入口一律返回 403（关闭外部调用入口）。
#   绝不能理解成「空口令也能过」—— 这三个接口都能改数据。
#
# ⚠ 长度要求：至少 32 个字符（建议 32 位随机十六进制，即 16 字节随机数）。
#   太短容易被暴力猜解；配置不生效时请先用 scripts/check-runtime.php 体检。
#
# 生成方式（二选一）：
#   # PHP CLI
#   php -r "echo bin2hex(random_bytes(16)), PHP_EOL;"
#   # Linux/macOS
#   openssl rand -hex 16
#
# ⚠ 本项目的真实配置入口是 config.php（由安装程序生成），.env 在当前版本
#   并未接入 EnvLoader —— 所以这一行只有在你自行接入 EnvLoader 后才会生效。
#   在当前版本请直接把下面这行写进 config.php：
#       define('CRON_SECRET', '<上面生成的 32 位十六进制串>');
#   或者在后台「系统设置 → 定时发布调度 Token」里填（等价于写数据库 settings 表）。
CRON_SECRET=""
