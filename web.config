<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hublog IIS 配置（前置条件：URL Rewrite 模块 + PHP Manager；PHP 需 fastcgi.impersonate=1、cgi.fix_pathinfo=1、fastcgi.logging=0）
  规则与 nginx.conf / .htaccess 对齐；伪静态关闭时所有路由走 PATH_INFO，无需此文件
-->
<configuration>

  <!-- 后台资源：禁强缓存 + 严格 CSP（对齐 nginx /admin/ 块） -->
  <location path="admin">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <add name="Content-Security-Policy" value="object-src 'none'; frame-ancestors 'none'; base-uri 'self'; script-src 'self'" />
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="X-Frame-Options" value="SAMEORIGIN" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <system.webServer>

    <!-- 1. 重写与防护（deny 规则在前，优先于路由重写） -->
    <rewrite>
      <rules>
        <rule name="Deny Sensitive Files" stopProcessing="true">
          <match url="^(config|install|fix_.*|security-check|composer)\.php|install\.lock$" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" />
        </rule>
        <rule name="Deny Internal Directories" stopProcessing="true">
          <match url="^(cache|backups|logs|sql|docs)(/|$)" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" />
        </rule>
        <rule name="Deny uploads PHP" stopProcessing="true">
          <match url="^uploads/.*\.php\d*(/|$)" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" />
        </rule>
        <rule name="Deny plugins PHP" stopProcessing="true">
          <match url="^plugins/.*\.php\d*(/|$)" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" />
        </rule>

        <rule name="Pass Authorization Header" stopProcessing="true">
          <match url=".*" />
          <serverVariables>
            <set name="HTTP_AUTHORIZATION" value="{HTTP_AUTHORIZATION}" />
          </serverVariables>
          <action type="None" />
        </rule>

        <rule name="Exclude Existing Files" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- 排除 api/index.php 直接访问（PATH_INFO 模式，不依赖伪静态） -->
        <rule name="API Rewrite" stopProcessing="true">
          <match url="^api/(.*)$" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/api/index\.php" negate="true" />
          </conditions>
          <action type="Rewrite" url="api/index.php" appendQueryString="true" />
        </rule>

        <rule name="Admin Rewrite" stopProcessing="true">
          <match url="^admin(/.*)?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="admin/index.html" appendQueryString="true" />
        </rule>

        <!-- 顶层 API 端点：/health /robots.txt /sitemap.xml → api/index.php
             这三个端点注册在 api/routes.php 顶层（不在 /api 组内），
             若落到前台入口 index.php 会被主题页分支排除（health 在保留字里），
             /health 返回的是首页 HTML 而不是 JSON -->
        <rule name="Top Level API Endpoints" stopProcessing="true">
          <match url="^(health|robots\.txt|sitemap\.xml)$" />
          <action type="Rewrite" url="api/index.php" appendQueryString="true" />
        </rule>

        <!-- 前台页面路由兜底：未命中静态文件的前台路径 → index.php
             与 nginx "location / { try_files $uri $uri/ /index.php?$query_string; }" 等价：
             主题扩展页（任意单段路径）与 /followers /following /messages /reset-password
             /wallet /points 等全部前台路由都由此可达，不再依赖硬编码白名单。
             条件里排除 /api/ /admin/ /uploads/ /plugins/ 与真实存在的文件、目录及静态扩展名 -->
        <rule name="Front Catch All" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(api|admin|uploads|plugins)(/|$)" negate="true" />
            <add input="{REQUEST_URI}" pattern="\.php(/|\?|$)" negate="true" />
            <add input="{REQUEST_URI}" pattern="\.(css|js|mjs|cjs|png|jpe?g|gif|bmp|ico|svg|webp|woff2?|ttf|eot|otf|php|html?|xml|txt|json|map)(\?.*)?$" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <!-- 2. 全局安全响应头 -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=()" />
      </customHeaders>
    </httpProtocol>

    <!-- 3. 隐藏文件与敏感扩展名保护 -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".env" />
          <add segment=".git" />
          <add segment=".idea" />
          <add segment=".installed.lock" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".zip" allowed="false" />
          <add fileExtension=".rar" allowed="false" />
          <add fileExtension=".7z" allowed="false" />
          <add fileExtension=".tar" allowed="false" />
          <add fileExtension=".gz" allowed="false" />
          <add fileExtension=".tgz" allowed="false" />
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".yml" allowed="false" />
          <add fileExtension=".yaml" allowed="false" />
          <add fileExtension=".phar" allowed="false" />
        </fileExtensions>
        <!-- 上传体积上限 100M（对齐 nginx client_max_body_size 100m /
             .htaccess php_value upload_max_filesize、post_max_size / Caddyfile request_body max_size） -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

    <!-- PHP 执行参数：上传体积上限 100M + 长任务超时（对齐 nginx 100m / .htaccess 100M） -->
    <httpRuntime maxRequestLength="104857600" executionTimeout="3600" />

    <!-- 4. 静态资源缓存（admin 已由上方 location 覆盖为 no-cache） -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
    </staticContent>

    <!-- 5. 默认文档 -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
      </files>
    </defaultDocument>

  </system.webServer>
</configuration>
